# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
CLIENT_ID=
# Optional: your server ID, so commands show up instantly while testing
GUILD_ID=

# Free key from https://steamcommunity.com/dev/apikey (optional, enables Steam stats)
STEAM_API_KEY=

# Free keys from https://dev.twitch.tv/console/apps (optional, enables Twitch live alerts)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
